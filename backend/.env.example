NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=isp_billing

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-too-another-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# Payment Gateway
# PAYMENT_PROVIDER: "mock" untuk simulasi, "ipaymu" untuk iPaymu, "midtrans" untuk Midtrans
PAYMENT_PROVIDER=ipaymu

# iPaymu Payment Gateway
IPAYMU_VA=your-ipaymu-va-number
IPAYMU_API_KEY=your-ipaymu-api-key
IPAYMU_IS_PRODUCTION=false
IPAYMU_NOTIFY_URL=http://localhost:3000/api/v1/webhooks/payment-gateway/ipaymu
IPAYMU_RETURN_URL=http://localhost:3001/invoices

# Payment Gateway (Midtrans - legacy, aktif jika PAYMENT_PROVIDER=midtrans)
MIDTRANS_SERVER_KEY=your-midtrans-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_IS_PRODUCTION=false

# Payment Gateway (Xendit example)
XENDIT_SECRET_KEY=your-xendit-secret-key
XENDIT_WEBHOOK_TOKEN=your-xendit-callback-verification-token

# IP whitelist tambahan untuk endpoint webhook (opsional, defense-in-depth).
# Isi dengan IP resmi payment gateway (cek dokumentasi Midtrans/Xendit terbaru
# saat konfigurasi -- JANGAN salin dari sumber lain yang mungkin sudah usang).
# Kosongkan untuk menonaktifkan (keamanan tetap bergantung pada signature verification).
# Contoh: WEBHOOK_ALLOWED_IPS=103.10.129.10,103.10.129.11
WEBHOOK_ALLOWED_IPS=

# WhatsApp Business API
WA_API_BASE_URL=https://graph.facebook.com/v20.0
WA_PHONE_NUMBER_ID=your-phone-number-id
WA_ACCESS_TOKEN=your-access-token

# Nomor WA admin penerima alert tiap pembayaran masuk (boleh >1, pisah koma)
ADMIN_WA_NUMBER=

# Business rules
INVOICE_REMINDER_DAYS_BEFORE=3,1
ISOLIR_GRACE_DAYS=3

# MikroTik credential encryption key (AES-256-GCM, 32-byte hex)
MIKROTIK_CRED_KEY=

# ─── Portal & CORS ───────────────────────────────────────────────
# Base URL portal pelanggan (dipakai untuk link pembayaran, verifikasi, atur password di email/WA)
PORTAL_BASE_URL=https://domain-anda.com/portal
# Origin frontend yang diizinkan CORS (pisahkan dengan koma). Kosong = izinkan semua.
CORS_ORIGIN=

# ─── Email (Brevo / transactional email) ─────────────────────────
# API key Brevo (Settings > SMTP & API > API Keys)
BREVO_API_KEY=
# Alamat pengirim terverifikasi di Brevo
BREVO_SENDER_EMAIL=
# Nama pengirim yang tampil di email
BREVO_SENDER_NAME=Khalifah Fiber Home
# URL logo publik untuk header email (https). Kosong = pakai nama brand sebagai teks.
EMAIL_LOGO_URL=

# ─── Siklus invoice ──────────────────────────────────────────────
# Berapa hari sebelum masa aktif berakhir invoice perpanjangan diterbitkan (default 3)
INVOICE_RENEWAL_DAYS_BEFORE=3

# ─── WhatsApp Gateway ────────────────────────────────────────────
# Provider WA: "webjs" (whatsapp-web.js, scan QR) atau "cloud" (Meta Cloud API)
WA_PROVIDER=webjs
# Lokasi penyimpanan sesi whatsapp-web.js (agar tidak perlu scan QR ulang tiap restart)
WA_SESSION_PATH=/var/www/ispbilling/backend/.wwebjs_auth
# Path ke binary Chrome/Chromium untuk whatsapp-web.js (puppeteer)
WA_CHROME_PATH=

# ─── MikroTik ────────────────────────────────────────────────────
# Mode simulasi operasi router: "true" = hanya log, tidak menulis ke RouterOS. Default nonaktif (produksi).
MIKROTIK_DRY_RUN=false
